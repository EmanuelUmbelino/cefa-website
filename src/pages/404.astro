---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import logoCream from '@/assets/logo-mark-cream.png';
import { withBase } from '@/utils/url';
---

<Base title="Page not found | CEFA" noindex>
  <main
    id="main"
    class="grid min-h-svh place-items-center bg-forest-900 px-4 text-center text-sage-100"
  >
    <div class="max-w-md">
      <Image src={logoCream} alt="" width={120} class="mx-auto mb-8 h-24 w-auto opacity-80" />
      <p class="eyebrow mb-3 text-sage-300">Error 404</p>
      <h1 class="text-4xl font-medium text-white sm:text-5xl">Lost in the mist</h1>
      <p class="mt-4 text-sage-100/80">The page you are looking for doesn’t exist or has moved.</p>
      <a href={withBase()} class="btn-primary mt-8">
        Back to the homepage
      </a>
    </div>
  </main>
</Base>
