---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { network } from '@/data/campaigns';
import { ambassadorsProgram, credits, site } from '@/data/site';
import forest from '@/assets/hero-forest.jpg';
---

<Base
  title="Ambassadors Program for student climate leaders · CEFA"
  description={ambassadorsProgram.metaDescription}
  breadcrumbs={[{ name: 'Ambassadors Program', path: '/ambassadors-program/' }]}
>
  <Header />
  <main id="main">
    <section
      class="relative isolate flex min-h-[75svh] flex-col justify-end overflow-hidden bg-forest-950 text-sage-50"
      aria-labelledby="ambassadors-title"
    >
      <Image
        src={forest}
        alt="Dense conifer forest on a mountainside, with mist drifting over the treetops"
        widths={[640, 960, 1280, 1600, 2400]}
        sizes="100vw"
        quality={80}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-20 size-full object-cover object-[center_75%]"
      />
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-b from-forest-950/70 via-forest-950/45 to-forest-950/95"
        aria-hidden="true"
      ></div>

      <div class="container-page pt-36 pb-16 sm:pb-20">
        <p class="eyebrow mb-4 text-sage-300" data-reveal>
          Ambassadors Program
        </p>
        <h1
          id="ambassadors-title"
          class="max-w-3xl text-5xl leading-[1.05] font-medium tracking-tight text-balance text-white sm:text-6xl"
          data-reveal
        >
          {ambassadorsProgram.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-sage-100/85" data-reveal>
          {ambassadorsProgram.lead}
        </p>
      </div>
      <p class="absolute right-4 bottom-3 text-[0.65rem] text-sage-100/50 sm:right-6">
        Photo:{' '}
        <a href={credits.heroPhoto.url} class="underline-offset-2 hover:underline">
          {credits.heroPhoto.author}
        </a>{' '}
        / Unsplash
      </p>
    </section>

    <section class="bg-paper py-24 sm:py-32" aria-labelledby="program-title">
      <div class="container-page">
        <SectionHeading
          id="program-title"
          eyebrow="The program"
          title="What ambassadors get"
          lead="Training is only the start. Ambassadors stay connected to CEFA and to each other while their campaigns grow."
        />
        <ul class="grid gap-6 sm:grid-cols-2">
          {ambassadorsProgram.parts.map((p) => (
            <li class="rounded-3xl border border-sage-300 bg-white p-8 sm:p-10" data-reveal>
              <span class="mb-6 grid size-12 place-items-center rounded-2xl bg-forest-700 text-sage-200">
                <Icon name={p.icon} size={24} />
              </span>
              <h3 class="mb-3 text-2xl font-medium text-forest-800">{p.title}</h3>
              <p class="leading-relaxed text-pretty text-ink-muted">{p.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-sage-100 py-24 sm:py-32" aria-labelledby="cohort-title">
      <div class="container-page">
        <SectionHeading
          id="cohort-title"
          eyebrow="Cohort 1"
          title="Where our first ambassadors are"
          lead="Ambassadors from our first cohort are building CEFA campaigns at universities across Canada and abroad."
        />
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {network.map((n) => (
            <li class="rounded-2xl border border-sage-300 bg-white p-6" data-reveal>
              <span class="mb-4 grid size-10 place-items-center rounded-full bg-forest-700 text-sage-200">
                <Icon name="map-pin" size={18} />
              </span>
              <p class="font-display text-lg leading-snug text-forest-800">{n.university}</p>
              <p class="mt-1 text-sm text-ink-muted">{n.place}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-forest-900 py-20 text-sage-50 sm:py-24" aria-labelledby="become-title">
      <div
        class="container-page flex flex-col items-start justify-between gap-8 md:flex-row md:items-center"
        data-reveal
      >
        <div class="max-w-2xl">
          <h2 id="become-title" class="text-3xl font-medium text-white sm:text-4xl">
            Become an ambassador
          </h2>
          <p class="mt-3 text-lg leading-relaxed text-pretty text-sage-100/85">
            Bring climate education to your university. We will train you and connect you with
            students who have done it before.
          </p>
        </div>
        <a href={site.forms.join} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Apply to join
          <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import '@/scripts/main';
</script>
