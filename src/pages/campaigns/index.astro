---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { network, ubc } from '@/data/campaigns';
import { site } from '@/data/site';
import { withBase } from '@/utils/url';
---

<Base
  title="Campaigns · CEFA"
  description="Student-led campaigns for climate education at universities across Canada and beyond, starting with the University of British Columbia Vancouver."
>
  <Header />
  <main id="main">
    <section
      class="bg-forest-900 pt-36 pb-20 text-sage-50 sm:pt-44 sm:pb-24"
      aria-labelledby="campaigns-title"
    >
      <div class="container-page">
        <p class="eyebrow mb-4 text-sage-300" data-reveal>
          Our campaigns
        </p>
        <h1
          id="campaigns-title"
          class="max-w-3xl text-5xl leading-[1.05] font-medium tracking-tight text-balance text-white sm:text-6xl"
          data-reveal
        >
          Climate education, one campus at a time
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-sage-100/85" data-reveal>
          Every CEFA campaign is led by students at their own university. They gather evidence of
          student demand, meet with decision-makers and work with instructors until climate
          education reaches every degree.
        </p>
      </div>
    </section>

    <section class="bg-paper py-24 sm:py-32" aria-labelledby="ubc-card-title">
      <div class="container-page">
        <article
          class="group grid overflow-hidden rounded-3xl border border-sage-300 bg-white lg:grid-cols-[1.15fr_1fr]"
          data-reveal
        >
          <div class="relative aspect-[4/3] overflow-hidden lg:aspect-auto">
            <Image
              src={ubc.cover.src}
              alt={ubc.cover.alt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 55vw, 100vw"
              class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
            />
          </div>
          <div class="flex flex-col p-8 sm:p-12">
            <p class="eyebrow mb-4 flex items-center gap-2 text-clay-600">
              <Icon name="map-pin" size={16} />
              {ubc.location} · Since {ubc.since.toLowerCase()}
            </p>
            <h2
              id="ubc-card-title"
              class="mb-4 text-3xl leading-tight font-medium text-balance text-forest-800 sm:text-4xl"
            >
              {ubc.name}
            </h2>
            <p class="mb-8 text-lg leading-relaxed text-pretty text-ink-muted">{ubc.summary}</p>
            <dl class="mb-10 grid grid-cols-2 gap-6">
              {ubc.stats.slice(0, 2).map((s) => (
                <div class="flex flex-col-reverse gap-1">
                  <dt class="text-sm leading-snug text-ink-muted">{s.label}</dt>
                  <dd class="font-display text-4xl font-medium text-forest-700">{s.value}</dd>
                </div>
              ))}
            </dl>
            <a href={withBase(`/campaigns/${ubc.slug}/`)} class="btn-primary mt-auto self-start">
              Explore the campaign
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </article>
      </div>
    </section>

    <section class="bg-sage-100 py-24 sm:py-32" aria-labelledby="network-title">
      <div class="container-page">
        <SectionHeading
          id="network-title"
          eyebrow="Across the network"
          title="Campaigns taking root"
          lead="Ambassadors from our first cohort are building CEFA campaigns at universities across Canada and abroad."
        />
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {network.map((n) => (
            <li class="rounded-2xl border border-sage-300 bg-white p-6" data-reveal>
              <span class="mb-4 grid size-10 place-items-center rounded-full bg-forest-700 text-sage-200">
                <Icon name="map-pin" size={18} />
              </span>
              <p class="font-display text-lg leading-snug text-forest-800">{n.university}</p>
              <p class="mt-1 text-sm text-ink-muted">{n.place}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-forest-900 py-20 text-sage-50 sm:py-24" aria-labelledby="start-title">
      <div
        class="container-page flex flex-col items-start justify-between gap-8 md:flex-row md:items-center"
        data-reveal
      >
        <div class="max-w-2xl">
          <h2 id="start-title" class="text-3xl font-medium text-white sm:text-4xl">
            Start a campaign at your university
          </h2>
          <p class="mt-3 text-lg leading-relaxed text-pretty text-sage-100/85">
            We will train you, share our toolkit and connect you with students who have done it
            before.
          </p>
        </div>
        <a href={site.forms.join} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Apply to join
          <Icon name="arrow-up-right" size={18} />
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import '@/scripts/main';
</script>
