---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { team } from '@/data/site';

const initials = (name: string) =>
  name
    .replace(/^Dr\.\s*/, '')
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2);
---

<section id="team" class="bg-paper py-24 sm:py-32" aria-labelledby="team-title">
  <div class="container-page">
    <SectionHeading
      id="team-title"
      eyebrow="Our team"
      title="The people behind CEFA"
      lead="Students, graduates and educators from the University of British Columbia, working with a growing network of volunteers and ambassadors."
    />

    <ul class="flex flex-wrap justify-center gap-x-8 gap-y-12">
      {team.map((m) => (
        <li
          class="flex w-full flex-col sm:w-[calc(50%-1rem)] lg:w-[calc((100%-4rem)/3)]"
          data-reveal
        >
          <div class="relative mb-6 aspect-[4/5] overflow-hidden rounded-3xl bg-forest-700">
            {m.photo ? (
              <Image
                src={m.photo}
                alt={`Portrait of ${m.name}`}
                widths={[360, 540, 720]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="size-full object-cover object-top"
              />
            ) : (
              <div
                class="grid size-full place-items-center bg-[radial-gradient(circle_at_30%_20%,var(--color-forest-500),var(--color-forest-800))]"
                aria-hidden="true"
              >
                <span class="font-display text-7xl text-sage-300/90">{initials(m.name)}</span>
              </div>
            )}
          </div>
          <p class="eyebrow mb-2 text-clay-600">{m.role}</p>
          <div class="mb-3 flex items-center justify-between gap-4">
            <h3 class="text-2xl font-medium text-forest-800">{m.name}</h3>
            <a
              href={m.link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${m.name}: ${m.link.label}`}
              title={m.link.label}
              class="grid size-10 shrink-0 place-items-center rounded-full bg-forest-700 text-sage-200 transition-colors hover:bg-clay-600 hover:text-white"
            >
              <Icon name={m.link.kind === 'linkedin' ? 'linkedin' : 'globe'} size={18} />
            </a>
          </div>
          {m.bio && <p class="leading-relaxed text-pretty text-ink-muted">{m.bio}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>
