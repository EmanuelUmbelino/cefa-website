---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { media } from '@/data/site';

const formatDate = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('en-CA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<section id="media" class="bg-sage-100 py-24 sm:py-32" aria-labelledby="media-title">
  <div class="container-page">
    <SectionHeading
      id="media-title"
      eyebrow="In the media"
      title="CEFA in the news"
      lead="Stories and opinion pieces about CEFA and the student movement for climate education."
    />

    <ul class:list={['grid gap-6', media.length > 1 ? 'md:grid-cols-2' : 'max-w-3xl']}>
      {media.map((item) => (
        <li data-reveal>
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex h-full flex-col rounded-3xl border border-sage-300 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-forest-300 hover:shadow-xl hover:shadow-forest-900/5 sm:p-10"
          >
            <div class="mb-8 flex items-center gap-3">
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-forest-700 text-sage-200 transition-colors group-hover:bg-clay-600 group-hover:text-white">
                <Icon name="newspaper" size={22} />
              </span>
              <span class="leading-tight">
                <span class="block font-semibold text-forest-800">{item.outlet}</span>
                <time datetime={item.date} class="text-sm text-ink-muted">
                  {formatDate(item.date)}
                </time>
              </span>
            </div>
            <h3 class="mb-3 text-2xl leading-snug font-medium text-balance text-forest-800 sm:text-3xl">
              {item.title}
            </h3>
            <p class="mb-2 text-sm text-clay-600">{item.byline}</p>
            <p class="mb-8 leading-relaxed text-pretty text-ink-muted">{item.summary}</p>
            <span class="mt-auto inline-flex items-center gap-2 font-semibold text-forest-700 group-hover:text-clay-600">
              Read the article
              <Icon name="arrow-up-right" size={18} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
