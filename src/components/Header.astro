---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { nav, site } from '@/data/site';
import { withBase } from '@/utils/url';
import logoMark from '@/assets/logo-mark.png';

/** Page links (not homepage sections) stay highlighted on their own pages. */
const isCurrentPage = (l: { href: string; section?: string }) =>
  !l.section && Astro.url.pathname.startsWith(withBase(l.href).replace(/\/$/, ''));

/** Page links come after the homepage sections, set apart by a divider. */
const startsPages = (i: number) => !nav[i]?.section && !!nav[i - 1]?.section;
---

<a
  href="#main"
  class="sr-only z-[60] rounded-full bg-clay-600 px-4 py-2 text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
>
  Skip to content
</a>

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 text-sage-100 transition-colors duration-300 data-[scrolled=true]:bg-forest-900/90 data-[scrolled=true]:shadow-lg data-[scrolled=true]:shadow-black/10 data-[scrolled=true]:backdrop-blur-md data-[open=true]:bg-forest-900/95"
>
  <nav class="container-page flex h-18 items-center justify-between gap-4" aria-label="Main">
    <a href={withBase()} class="group flex items-center gap-3">
      <span class="grid size-11 place-items-center rounded-full bg-sage-300 transition-transform duration-300 group-hover:-rotate-6">
        <Image src={logoMark} alt="" width={40} class="h-7 w-auto" loading="eager" />
      </span>
      <span class="leading-tight">
        <span class="block font-display text-xl font-semibold tracking-tight">
          {site.shortName}
        </span>
        <span class="hidden text-[0.7rem] tracking-wide text-sage-200/80 sm:block">
          {site.name}
        </span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {nav.map((l, i) => (
        <li class="group/nav relative flex items-center gap-1">
          {startsPages(i) && (
            <span class="px-1 text-sage-100/40 select-none" aria-hidden="true">
              |
            </span>
          )}
          <a
            href={withBase(l.href)}
            data-nav-link={l.section}
            aria-current={isCurrentPage(l) ? 'true' : undefined}
            class="inline-flex items-center gap-1 rounded-full px-3 py-2 text-sm text-sage-100/80 transition-colors group-hover/nav:text-white hover:text-white aria-[current=true]:text-white aria-[current=true]:underline aria-[current=true]:decoration-clay-400 aria-[current=true]:decoration-2 aria-[current=true]:underline-offset-8"
          >
            {l.label}
            {l.children && (
              <Icon
                name="chevron-down"
                size={14}
                class="transition-transform group-focus-within/nav:rotate-180 group-hover/nav:rotate-180"
              />
            )}
          </a>
          {l.children && (
            <ul class="invisible absolute top-full right-0 min-w-44 translate-y-1 pt-2 opacity-0 transition-all duration-200 group-focus-within/nav:visible group-focus-within/nav:translate-y-0 group-focus-within/nav:opacity-100 group-hover/nav:visible group-hover/nav:translate-y-0 group-hover/nav:opacity-100">
              <li class="rounded-2xl border border-white/10 bg-forest-900/95 p-1.5 shadow-xl shadow-black/20 backdrop-blur-md">
                <ul>
                  {l.children.map((c) => (
                    <li>
                      <a
                        href={withBase(c.href)}
                        aria-current={isCurrentPage(c) ? 'true' : undefined}
                        class="block rounded-xl px-4 py-2.5 text-sm text-sage-100/85 transition-colors hover:bg-white/10 hover:text-white aria-[current=true]:text-white"
                      >
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            </ul>
          )}
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a href={withBase('/#get-involved')} class="btn-primary hidden px-5 py-2.5 sm:inline-flex">
        Join us
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-label-open="Open menu"
        data-label-close="Close menu"
        class="group grid size-10 place-items-center rounded-full transition-colors hover:bg-white/10 lg:hidden"
      >
        <Icon name="menu" size={22} class="group-aria-expanded:hidden" />
        <Icon name="x" size={22} class="hidden group-aria-expanded:block" />
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    data-menu
    hidden
    class="border-t border-white/10 bg-forest-900/95 backdrop-blur-md lg:hidden"
  >
    <ul class="container-page flex flex-col py-3">
      {nav.map((l, i) => (
        <li class:list={[startsPages(i) && 'mt-2 border-t border-white/10 pt-2']}>
          <a
            href={withBase(l.href)}
            class="block rounded-xl px-3 py-3 text-base text-sage-100/85 transition-colors hover:bg-white/5 hover:text-white"
          >
            {l.label}
          </a>
          {l.children && (
            <ul class="ml-3 border-l border-white/10 pl-3">
              {l.children.map((c) => (
                <li>
                  <a
                    href={withBase(c.href)}
                    class="block rounded-xl px-3 py-2.5 text-sm text-sage-100/75 transition-colors hover:bg-white/5 hover:text-white"
                  >
                    {c.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li class="px-3 pt-2 pb-1 sm:hidden">
        <a href={withBase('/#get-involved')} class="btn-primary w-full">
          Join us
        </a>
      </li>
    </ul>
  </div>
</header>
