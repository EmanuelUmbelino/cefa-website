---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { programs } from '@/data/site';
import { withBase } from '@/utils/url';
---

<section id="what-we-do" class="bg-paper py-24 sm:py-32" aria-labelledby="what-we-do-title">
  <div class="container-page">
    <SectionHeading
      id="what-we-do-title"
      eyebrow="What we do"
      title="From one campus to every campus"
      lead="CEFA works through a growing network of students who bring climate education to their universities — with training, campaigns and spaces to gather."
    />

    <ol class="grid gap-6 md:grid-cols-3">
      {programs.map((p, i) => (
        <li
          class="group relative flex flex-col rounded-3xl border border-sage-300 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-forest-300 hover:shadow-xl hover:shadow-forest-900/5"
          data-reveal
        >
          <div class="mb-8 flex items-center justify-between">
            <span class="grid size-12 place-items-center rounded-2xl bg-forest-700 text-sage-200 transition-colors group-hover:bg-clay-600 group-hover:text-white">
              <Icon name={p.icon} size={24} />
            </span>
            <span class="font-display text-4xl text-sage-400" aria-hidden="true">
              0{i + 1}
            </span>
          </div>
          <h3 class="mb-3 text-2xl font-medium text-forest-800">{p.title}</h3>
          <p class="leading-relaxed text-pretty text-ink-muted">{p.text}</p>
        </li>
      ))}
    </ol>

    <div class="mt-12 flex justify-center" data-reveal>
      <a href={withBase('/campaigns/')} class="btn-forest">
        Explore our campaigns
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>
