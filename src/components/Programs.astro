---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { programs } from '@/data/site';
import { withBase } from '@/utils/url';
---

<section id="what-we-do" class="bg-paper py-24 sm:py-32" aria-labelledby="what-we-do-title">
  <div class="container-page">
    <SectionHeading
      id="what-we-do-title"
      eyebrow="What we do"
      title="From one campus to every campus"
      lead="CEFA works through a growing network of students who bring climate education to their universities, with ambassador training and campus campaigns."
    />

    <ul class="grid gap-6 md:grid-cols-2">
      {programs.map((p) => (
        <li
          class="group relative isolate flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-3xl bg-forest-900 p-8 sm:p-10"
          data-reveal
        >
          <Image
            src={p.image.src}
            alt={p.image.alt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="absolute inset-0 -z-20 size-full object-cover object-[center_30%] transition-transform duration-700 group-hover:scale-[1.04]"
          />
          <div
            class="absolute inset-0 -z-10 bg-gradient-to-t from-forest-950/90 via-forest-950/40 to-forest-950/10"
            aria-hidden="true"
          ></div>
          <h3 class="mb-6 text-3xl font-medium text-white sm:text-4xl">{p.title}</h3>
          <a href={withBase(p.href)} class="btn-light self-start">
            {p.cta}
            {p.ctaContext && <span class="sr-only"> {p.ctaContext}</span>}
            <Icon name="arrow-right" size={18} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
