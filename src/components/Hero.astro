---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { credits, hero, site } from '@/data/site';
import forest from '@/assets/hero-forest.jpg';
import logoWhite from '@/assets/logo-mark-white.png';
---

<section
  id="top"
  class="relative isolate flex min-h-svh flex-col justify-end overflow-hidden bg-forest-950 text-sage-50"
  aria-labelledby="hero-title"
>
  <Image
    src={forest}
    alt="Dense conifer forest on a mountainside, with mist drifting over the treetops"
    widths={[640, 960, 1280, 1600, 2000, 2560, 3200]}
    sizes="100vw"
    quality={82}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-top"
  />

  <!-- Drifting mist -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -inset-x-1/4 top-0 h-1/2 animate-mist bg-[radial-gradient(ellipse_at_30%_50%,rgb(255_255_255/0.16),transparent_60%),radial-gradient(ellipse_at_75%_40%,rgb(255_255_255/0.12),transparent_55%)] blur-2xl"></div>
  </div>

  <!-- Legibility gradients -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-b from-forest-950/50 via-forest-950/20 to-forest-950/90"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-forest-950/60 via-forest-950/10 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="container-page pt-32 pb-28 sm:pb-32">
    <div class="max-w-4xl">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-8" data-reveal>
        <Image
          src={logoWhite}
          alt=""
          width={240}
          loading="eager"
          class="h-24 w-auto shrink-0 drop-shadow-[0_4px_24px_rgb(0_0_0/0.35)] sm:h-36 lg:h-44"
        />
        <h1
          id="hero-title"
          class="text-5xl leading-[1.02] font-medium tracking-tight text-balance text-white sm:text-6xl lg:text-7xl"
        >
          {site.name}
        </h1>
      </div>
      <p
        class="mt-8 font-display text-2xl leading-snug text-pretty text-sage-200 sm:text-3xl"
        data-reveal
      >
        {hero.tagline}
      </p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pretty text-sage-100/85" data-reveal>
        {hero.lead}
      </p>
      <div class="mt-9 flex flex-wrap gap-3" data-reveal>
        <a href="#get-involved" class="btn-primary">
          Join the movement
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="#mission" class="btn-light">
          Our mission
        </a>
      </div>
    </div>
  </div>

  <a
    href="#about"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-1 text-xs tracking-widest text-sage-200/80 uppercase transition-colors hover:text-white sm:flex"
  >
    Scroll
    <Icon name="arrow-down" size={18} class="animate-cue" />
  </a>

  <p class="absolute right-4 bottom-3 text-[0.65rem] text-sage-100/50 sm:right-6">
    Photo:{' '}
    <a href={credits.heroPhoto.url} class="underline-offset-2 hover:underline">
      {credits.heroPhoto.author}
    </a>{' '}
    / Unsplash
  </p>
</section>
