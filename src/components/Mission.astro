---
import { Image } from 'astro:assets';
import { mission } from '@/data/site';
import logoCream from '@/assets/logo-mark-cream.png';
---

<section
  id="mission"
  class="relative isolate overflow-hidden bg-forest-700 py-24 text-sage-50 sm:py-32"
  aria-labelledby="mission-title"
>
  <Image
    src={logoCream}
    alt=""
    width={520}
    class="pointer-events-none absolute top-1/2 -right-24 -z-10 h-[130%] w-auto -translate-y-1/2 opacity-[0.07] select-none sm:-right-10"
  />

  <div class="container-page">
    <h2 id="mission-title" class="sr-only">
      Mission and vision
    </h2>
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <p class="eyebrow mb-5 flex items-center gap-3 text-sage-300">
          <span class="h-px w-10 bg-clay-400" aria-hidden="true"></span>
          Our mission
        </p>
        <p class="font-display text-2xl leading-snug font-normal text-pretty text-white sm:text-3xl">
          {mission.mission}
        </p>
      </div>
      <div data-reveal>
        <p class="eyebrow mb-5 flex items-center gap-3 text-sage-300">
          <span class="h-px w-10 bg-clay-400" aria-hidden="true"></span>
          Our vision
        </p>
        <p class="font-display text-2xl leading-snug font-normal text-pretty text-white sm:text-3xl">
          {mission.vision}
        </p>
      </div>
    </div>
  </div>
</section>
