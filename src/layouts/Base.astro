---
import '@/styles/global.css';
import { site } from '@/data/site';
import { withBase } from '@/utils/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Trail from the homepage to this page, for search-result breadcrumbs. */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title = site.metaTitle,
  description = site.metaDescription,
  noindex = false,
  breadcrumbs,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('og-image.jpg'), Astro.site);
const home = new URL(withBase(), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NGO',
      '@id': `${home}#organization`,
      name: site.name,
      alternateName: site.shortName,
      description: site.description,
      url: home,
      logo: new URL(withBase('apple-touch-icon.png'), Astro.site).href,
      email: site.email,
      foundingDate: String(site.foundedYear),
      sameAs: [site.instagram.url, site.linkedin.url],
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: site.name,
      alternateName: site.shortName,
      url: home,
      inLanguage: 'en-CA',
      publisher: { '@id': `${home}#organization` },
    },
    ...(breadcrumbs
      ? [
          {
            '@type': 'BreadcrumbList',
            itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((crumb, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: crumb.name,
              item: new URL(withBase(crumb.path), Astro.site).href,
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <link rel="icon" href={withBase('favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    <meta name="theme-color" content="#082f26" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-dvh overflow-x-hidden">
    <slot />
  </body>
</html>
